{
  "version": "1.0",
  "policies": [
    {
      "id": "boot_integrity_check",
      "description": "Enforce verified boot integrity using AVB.",
      "enabled": true,
      "action_on_failure": "LOCKDOWN",
      "parameters": {
        "tool": "avbtool",
        "command": "verify_image",
        "target": "/dev/block/by-name/boot"
      }
    },
    {
      "id": "hardware_keystore_init",
      "description": "Ensure hardware-backed keystore is initialized.",
      "enabled": true,
      "action_on_failure": "WARN",
      "parameters": {
        "service": "guardian_hardware_init"
      }
    },
    {
      "id": "iu_tamper_detection",
      "description": "Detect tampering with Interface User security components.",
      "enabled": true,
      "action_on_failure": "RESTRICTED_MODE",
      "parameters": {
        "check_file": "/data/acing/tamper_detected"
      }
    },
    {
      "id": "admin_biometric_auth",
      "description": "Require biometric or strong authentication for admin dashboard access.",
      "enabled": true,
      "action_on_failure": "DENY_ACCESS",
      "parameters": {
        "target_app": "com.acing.iu.admin",
        "auth_type": "BIOMETRIC_OR_STRONG"
      }
    },
    {
      "id": "secure_workspace_encryption",
      "description": "Enforce session-based encryption for sensitive admin operations.",
      "enabled": true,
      "action_on_failure": "BLOCK_OPERATION",
      "parameters": {
        "roles": ["ADMIN"],
        "sensitive_operations": ["AI_CHAT", "NOTES", "FIRMWARE_UPLOAD"]
      }
    },
    {
      "id": "device_trust_thresholds",
      "description": "Apply trust-based access thresholds for Interface User capabilities.",
      "enabled": true,
      "action_on_failure": "RESTRICTED_MODE",
      "parameters": {
        "minimal_access_threshold": 40,
        "restricted_mode_threshold": 70
      }
    },
    {
      "id": "device_trust_minimal_iu_enforcement",
      "description": "Restrict users to minimal IU when trust score is below threshold.",
      "enabled": true,
      "action_on_failure": "MINIMAL_IU_ONLY",
      "parameters": {
        "trust_score_operator": "<",
        "trust_score_value": 40
      }
    }
  ]
}
