# Copy to .env — never commit real values.
# Compose fails closed if required secrets are unset.

POSTGRES_USER=acing_admin
POSTGRES_PASSWORD=replace_with_strong_admin_password
POSTGRES_DB=acing_iu
POSTGRES_PORT=5432

MIGRATOR_DB_USER=acing_migrator
MIGRATOR_DB_PASSWORD=replace_with_strong_migrator_password

IDENTITY_DB_USER=acing_identity
IDENTITY_DB_PASSWORD=replace_with_strong_identity_password

DEVICE_TRUST_DB_USER=acing_device_trust
DEVICE_TRUST_DB_PASSWORD=replace_with_strong_device_trust_password

REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_PORT=6379

GATEWAY_PORT=8080

JWT_ISSUER=acing-iu
JWT_AUDIENCE=acing-iu-api
JWT_SIGNING_KEY=replace_with_at_least_32_char_random_secret

# Generate with: openssl rand -base64 32
# Keep key material in the approved secret manager; never commit a real value.
MFA_SECRET_PROTECTION_ACTIVE_KEY_ID=mfa-v1
MFA_SECRET_PROTECTION_KEY_MFA_V1=replace_with_base64_encoded_32_byte_key

ASPNETCORE_ENVIRONMENT=Development

# Optional local volume names. Override to validate clean initialization without deleting existing data.
POSTGRES_VOLUME_NAME=acing-postgres-data
REDIS_VOLUME_NAME=acing-redis-data
