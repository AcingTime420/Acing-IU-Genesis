direction: right

// Define components
Hardware: {
  shape: cylinder
  label: "Hardware Abstraction\n(Keystore + TrustZone)"
}

BootIntegrity: {
  shape: hexagon
  label: "Boot Integrity Layer\n(Verified Boot + AVB 2.0)"
}

GuardianInit: {
  shape: file
  label: "guardian_init.sh\n(Boot Integration)"
}

IUSecurityInit: {
  shape: file
  label: "iu_security_init\n(Interface User Security)"
}

IUSecurityAuth: {
  shape: component
  label: "iu_auth_service\n(Auth Stub)"
}

GuardianService: {
  shape: component
  label: "GuardianService.kt\n(System Service)"
}

ThreatEngine: {
  shape: cloud
  label: "Real-time Threat Engine\n(Malware, Anomaly, Network)"
}

PolicyEngine: {
  shape: component
  label: "Policy & Compliance Engine\n(policies.json)"
}

SecureWorkspace: {
  shape: container
  label: "Secure Workspace Container\n(Secure Folder-like)"
}

AdminDashboard: {
  shape: rectangle
  label: "Admin Dashboard\n(Centralized Security Center)"
}

AdminDashboardCard: {
  shape: component
  label: "AdminDashboardSecurityCard.kt"
}

// Define relationships
Hardware -> BootIntegrity: "Provides Root of Trust"
BootIntegrity -> GuardianInit: "Triggers"
GuardianInit -> IUSecurityInit: "Activates"
GuardianInit -> Hardware: "Initializes Keystore"
GuardianInit -> ThreatEngine: "Starts Monitoring"
GuardianInit -> PolicyEngine: "Loads Policies"
IUSecurityInit -> IUSecurityAuth: "Starts"
IUSecurityInit -> AdminDashboard: "Protects UI Components"
GuardianService -> ThreatEngine: "Manages"
GuardianService -> AdminDashboard: "Feeds Data"
GuardianService -> IUSecurityInit: "Enhances Protection"
GuardianService -> SecureWorkspace: "Enables for Roles"
PolicyEngine -> GuardianService: "Enforces Rules"
AdminDashboard -> AdminDashboardCard: "Displays"
ThreatEngine -> GuardianService: "Reports Threats"
