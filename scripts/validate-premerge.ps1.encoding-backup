#Requires -Version 5.1
<#
.SYNOPSIS
  Acing IU Genesis — pre-merge validation (fail-closed).
.NOTES
  Status: Implementation baseline: Pending local validation
  Does not claim success unless every step exits 0 on your machine.
#>
$ErrorActionPreference = "Stop"
$Root = Resolve-Path (Join-Path $PSScriptRoot "..")
Set-Location $Root
$ComposeDir = Join-Path $Root "infrastructure"
$EnvFile = Join-Path $ComposeDir ".env"
$script:CleanedUp = $false

function Invoke-Cleanup {
  if ($script:CleanedUp) { return }
  $script:CleanedUp = $true
  if (Test-Path $EnvFile) {
    Write-Host "`n=== Cleanup (preserving named volumes) ==="
    try {
      Push-Location $ComposeDir
      docker compose down --remove-orphans 2>$null | Out-Null
    } catch {
      # best-effort
    } finally {
      Pop-Location
    }
  }
}

Register-EngineEvent -SourceIdentifier PowerShell.Exiting -Action { Invoke-Cleanup } | Out-Null
trap {
  Write-Host "FAIL: $($_.Exception.Message)" -ForegroundColor Red
  Invoke-Cleanup
  exit 1
}

function Step([string]$Name, [scriptblock]$Action) {
  Write-Host "`n=== $Name ===" -ForegroundColor Cyan
  & $Action
  Write-Host "PASS: $Name" -ForegroundColor Green
}

function Import-DotEnv {
  param([Parameter(Mandatory)][string]$Path)

  if (-not (Test-Path $Path)) {
    throw "Missing $Path — copy infrastructure/.env.example and set secrets"
  }

  $required = @(
    "POSTGRES_USER",
    "POSTGRES_DB",
    "POSTGRES_PASSWORD",
    "IDENTITY_DB_PASSWORD",
    "DEVICE_TRUST_DB_PASSWORD",
    "JWT_SIGNING_KEY",
    "REDIS_PASSWORD"
  )
  $seen = @{}

  $lines = Get-Content -Path $Path -Encoding UTF8
  foreach ($raw in $lines) {
    $line = $raw -replace "`r", ""
    if ([string]::IsNullOrWhiteSpace($line)) { continue }
    $trimmed = $line.TrimStart()
    if ($trimmed.StartsWith("#")) { continue }

    $eq = $line.IndexOf("=")
    if ($eq -lt 0) {
      throw "Invalid .env line (no =): $($line.Substring(0, [Math]::Min(40, $line.Length)))..."
    }
    $key = $line.Substring(0, $eq).Trim()
    $val = $line.Substring($eq + 1)
    if ([string]::IsNullOrWhiteSpace($key)) {
      throw "Invalid .env entry with empty key"
    }
    if ($seen.ContainsKey($key)) {
      throw "Duplicate key in .env: $key"
    }
    $seen[$key] = $true
    Set-Item -Path "Env:$key" -Value $val
  }

  foreach ($k in $required) {
    if (-not (Test-Path "Env:$k")) {
      throw "Required variable missing from .env: $k"
    }
    $v = (Get-Item "Env:$k").Value
    if ([string]::IsNullOrWhiteSpace($v)) {
      throw "Required variable is blank in .env: $k"
    }
  }
  Write-Host "Loaded required variables from infrastructure/.env (values not shown)"
}

function Wait-PostgresReady {
  $tries = 30
  for ($i = 1; $i -le $tries; $i++) {
    Push-Location $ComposeDir
    try {
      docker compose exec -T postgres pg_isready -U $env:POSTGRES_USER -d $env:POSTGRES_DB 2>$null | Out-Null
      if ($LASTEXITCODE -eq 0) {
        Write-Host "PostgreSQL is ready"
        return
      }
    } finally {
      Pop-Location
    }
    Start-Sleep -Seconds 2
  }
  throw "PostgreSQL did not become ready within $($tries * 2)s"
}

function Assert-ExitZero {
  param([string]$Context)
  if ($LASTEXITCODE -ne 0) {
    throw "$Context failed with exit code $LASTEXITCODE"
  }
}

Step "0. Load environment" {
  Import-DotEnv -Path $EnvFile
}

Step "1. Tool versions" {
  dotnet --version | Out-Host
  docker --version | Out-Host
  docker compose version | Out-Host
}

Step "2. dotnet restore" {
  dotnet restore backend/AcingIU.sln
  Assert-ExitZero "dotnet restore"
}

Step "3. dotnet build" {
  dotnet build backend/AcingIU.sln -c Release --no-restore
  Assert-ExitZero "dotnet build"
}

Step "4. dotnet test" {
  if (-not (Get-ChildItem -Path tests -Filter *.csproj -Recurse -ErrorAction SilentlyContinue)) {
    throw "No test projects under tests/"
  }
  dotnet test backend/AcingIU.sln -c Release --no-build --verbosity normal
  Assert-ExitZero "dotnet test"
}

Step "5. OpenAPI lint" {
  $specs = @(
    "docs/irp/03-openapi/identity.openapi.yaml",
    "docs/irp/03-openapi/device-trust.openapi.yaml",
    "irp/03-openapi/identity.openapi.yaml",
    "irp/03-openapi/device-trust.openapi.yaml"
  ) | Where-Object { Test-Path $_ }
  if (-not $specs) { throw "No OpenAPI specs found" }
  foreach ($s in $specs) {
    npx --yes @redocly/cli@1.25.15 lint $s
    Assert-ExitZero "OpenAPI lint $s"
  }
}

Step "6. Docker Compose config" {
  Push-Location $ComposeDir
  try {
    docker compose config -q
    Assert-ExitZero "docker compose config"
  } finally {
    Pop-Location
  }
}

Step "7. PostgreSQL up + readiness" {
  Push-Location $ComposeDir
  try {
    docker compose up -d postgres
    Assert-ExitZero "docker compose up postgres"
  } finally {
    Pop-Location
  }
  Wait-PostgresReady
}

Step "8. Migrations (fail-closed)" {
  Push-Location $ComposeDir
  try {
    docker compose run --rm db-migrate
    Assert-ExitZero "db-migrate"
  } finally {
    Pop-Location
  }
}

Step "9. Constraint tests" {
  Push-Location $ComposeDir
  try {
    Get-Content (Join-Path $Root "tests/database/constraint_tests.sql") -Raw |
      docker compose exec -T postgres psql -U $env:POSTGRES_USER -d $env:POSTGRES_DB -v ON_ERROR_STOP=1
    Assert-ExitZero "constraint_tests"
  } finally {
    Pop-Location
  }
}

Step "10. Privilege probes" {
  Push-Location $ComposeDir
  try {
    docker compose exec -T -e "PGPASSWORD=$($env:IDENTITY_DB_PASSWORD)" postgres `
      psql -U acing_identity -d $env:POSTGRES_DB -c "UPDATE security_audit_logs SET actor='x'" 2>$null | Out-Null
    if ($LASTEXITCODE -eq 0) {
      throw "acing_identity was allowed to UPDATE security_audit_logs"
    }
    docker compose exec -T -e "PGPASSWORD=$($env:DEVICE_TRUST_DB_PASSWORD)" postgres `
      psql -U acing_device_trust -d $env:POSTGRES_DB -c "DELETE FROM security_audit_logs" 2>$null | Out-Null
    if ($LASTEXITCODE -eq 0) {
      throw "acing_device_trust was allowed to DELETE security_audit_logs"
    }
    Write-Host "Runtime roles cannot mutate audit"
  } finally {
    Pop-Location
  }
}

Step "11. Full stack + smoke" {
  Push-Location $ComposeDir
  try {
    docker compose up -d --build
    Assert-ExitZero "docker compose up --build"
  } finally {
    Pop-Location
  }
  Wait-PostgresReady
  Start-Sleep -Seconds 10
  Push-Location $ComposeDir
  try {
    if (-not (Get-Command bash -ErrorAction SilentlyContinue)) {
      throw "bash not found — install Git Bash or WSL to run smoke-auth.sh"
    }
    bash ./scripts/smoke-auth.sh
    Assert-ExitZero "smoke-auth.sh"
  } finally {
    Pop-Location
  }
}

Step "12. Trivy optional" {
  if (Get-Command trivy -ErrorAction SilentlyContinue) {
    docker build -t acing-identity:local backend/Identity/src/AcingIU.Identity.Api
    Assert-ExitZero "docker build identity"
    trivy image --severity CRITICAL,HIGH --exit-code 1 acing-identity:local
    Assert-ExitZero "trivy"
  } else {
    Write-Host "Trivy not installed — skip (CI container workflow covers this)"
  }
}

Write-Host "`n=== SUMMARY: ALL EXECUTED STEPS PASSED ON THIS MACHINE ===" -ForegroundColor Green
Invoke-Cleanup
exit 0
